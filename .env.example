# Required. Server-side only — never prefixed with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Leave blank for OpenAI. Point at any OpenAI-compatible provider:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#   DeepInfra   https://api.deepinfra.com/v1/openai
#   Ollama      http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional. Any model the provider serves. Defaults to gpt-4o.
FORGE_MODEL=gpt-4o

# Optional. Hard ceiling on the forge round-trip, milliseconds.
# Clamped to 8000..60000. Defaults to 60000.
FORGE_TIMEOUT_MS=60000
