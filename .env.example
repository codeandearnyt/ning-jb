# Ning-JB environment.
# Copy to .env.local for dev, or paste into Vercel → Settings → Environment Variables.
# Server-side only. Never prefix any of these with NEXT_PUBLIC_.
#
# ALL OF THIS IS OPTIONAL. Ning-JB is bring-your-own-key: visitors paste a key
# into the form and it travels with the request. Set a variable here only if you
# want every visitor to inherit that key when their key field is blank.
# ─────────────────────────────────────────────────────────────

# 1. OpenAI — also the default provider when none is selected.
OPENAI_API_KEY=
# Optional. Overrides the OpenAI base URL (kept for backward compatibility).
OPENAI_BASE_URL=
# Optional. Default model for the OpenAI provider.
FORGE_MODEL=

# 2. Anthropic Claude — api.anthropic.com/v1 (OpenAI-compatible surface).
# Rejects response_format; the forge drops it and retries automatically.
ANTHROPIC_API_KEY=

# 3. Google Gemini — generativelanguage.googleapis.com/v1beta/openai/
# Either variable works; GEMINI_API_KEY is tried first.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 4. Groq — api.groq.com/openai/v1
GROQ_API_KEY=

# 5. NVIDIA NIM — integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=

# 6. Cloudflare AI Gateway — gateway.ai.cloudflare.com/v1/{account}/{gateway}/compat
# Account id and gateway id are required. Gateway id defaults to "default".
CF_AIG_TOKEN=
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CF_GATEWAY_ID=

# 7. OpenRouter — openrouter.ai/api/v1
OPENROUTER_API_KEY=

# 8. OpenCode Zen — opencode.ai/inference/openai/v1
OPENCODE_API_KEY=

# 9. Ollama — localhost:11434/v1. Key is optional; runs on the host, so it only
#    works self-hosted. Vercel has no localhost.
OLLAMA_API_KEY=

# 10. Custom Integration — any OpenAI-compatible endpoint.
#     The base URL is read from the server only, never from the browser.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ─────────────────────────────────────────────────────────────
# Forge behaviour
# ─────────────────────────────────────────────────────────────

# Hard ceiling on the forge round-trip, milliseconds.
# Clamped to 8000..60000. Defaults to 60000.
FORGE_TIMEOUT_MS=60000
